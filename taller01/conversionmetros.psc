Algoritmo conversionmetros
	Definir m Como Real
	Escribir 'Digite la cantidad en metros:'
	Leer m
	km <- m / 1000
	hm <- m / 100
	dam <- m / 10
	dm <- m * 10
	cm <- m * 100
	mm <- m * 1000
	Escribir m, ' metros equivalen a:'
	Escribir km, ' kilómetros'
	Escribir hm, ' hectómetros'
	Escribir dam, ' decámetros'
	Escribir dm, ' decímetros'
	Escribir cm, ' centímetros'
	Escribir mm, ' milímetros'
FinAlgoritmo