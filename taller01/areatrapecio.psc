Algoritmo areatrapecio
	Definir bmen, bmay, h Como real
	Escribir 'Digita la longitud de la base menor'
	leer bmen
	Escribir 'Digita la longitud de la base mayor'
	leer bmay
	Escribir 'Digita la longitud de la altura'
	leer h
	armb<-((bmen+bmay)/2)*h
	Escribir 'El area de un trapecio cuya base menor mide ' bmen ', su base mayor ' bmay ' y su altura ' h ' equivale a ' armb
FinAlgoritmo